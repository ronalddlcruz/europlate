{
  "name": "europlate",
  "version": "1.0.0",
  "description": "Europlate — Sistema de Gestión Comercial",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,blue --kill-others \"tsx watch server/server.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/server.ts",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed.js",
    "server:dev": "npm run dev:api",
    "server:build": "tsc -p server/tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma db execute --stdin < prisma/healthcheck.sql",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "express": "^5.1.0",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.6.1",
    "netlify-cli": "^17.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "tsx": "^4.19.3",
    "prisma": "^6.4.1",
    "vite": "^6.0.5"
  }
}
