{
  "name": "europlate",
  "version": "1.0.0",
  "description": "Europlate — Sistema de Gestión Comercial",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,blue --kill-others \"tsx watch server/server.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/server.ts",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "lint": "eslint src --max-warnings 0",
    "lint:nest": "eslint server-nest/src --max-warnings 0",
    "lint:server:instrumentation": "eslint server/src/shared/observability server/src/shared/openapi --max-warnings 0",
    "format": "prettier --write src",
    "format:check": "prettier --check src/features/auth",
    "format:check:all": "prettier --check src",
    "format:auth": "prettier --write src/features/auth",
    "preview": "vite preview",
    "seed": "node scripts/seed.js",
    "server:dev": "npm run dev:api",
    "server:build": "tsc -p server/tsconfig.json",
    "test:database-url": "tsx --test server/src/infrastructure/database/connection-url.test.ts",
    "test:observability": "tsx --test server/src/shared/observability/http-metrics.test.ts server/src/shared/observability/observability.contract.test.ts server/src/shared/openapi/openapi.document.test.ts",
    "nest:dev": "npm run nest:build && concurrently -n nest-ts,nest-api -c cyan,blue --kill-others \"tsc -p server-nest/tsconfig.json --watch\" \"node --watch server-nest/dist/main.js\"",
    "nest:build": "tsc -p server-nest/tsconfig.json",
    "nest:start": "node server-nest/dist/main.js",
    "nest:test": "npm run nest:build && node --test server-nest/dist/config/database/database-url.test.js server-nest/dist/modules/auth/auth.contract.test.js",
    "nest:benchmark": "node server-nest/scripts/benchmark-auth.mjs",
    "nest:diagnose": "node server-nest/scripts/diagnose-auth.mjs",
    "nest:verify:db": "npm run nest:build && node server-nest/scripts/verify-auth-repository.mjs",
    "test:frontend": "tsx --tsconfig tsconfig.app.json --test src/lib/product-search.test.ts src/lib/api-client.test.ts src/features/auth/schemas/auth.schema.test.ts src/features/products/domain/product-list.test.ts src/features/products/domain/synchronize-attribute-definition.test.ts",
    "test:imports": "tsx --test server/src/modules/imports/services/import-line-calculator.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma db execute --stdin < prisma/healthcheck.sql",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-users": "tsx prisma/seed-users.ts",
    "db:normalize-product-roles": "tsx scripts/normalize-product-roles.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "netlify-cli": "^17.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "prisma": "^6.4.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.5"
  }
}
