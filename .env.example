# ── Base de datos PostgreSQL ────────────────────────────────────────────────
# Obtén esta cadena de conexión desde Neon (neon.tech) o Supabase (supabase.com)
SUPABASE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Para Supabase, usa la conexión directa (puerto 5432) al ejecutar migraciones.
# SUPABASE_DATABASE_URL puede usar el pooler compartido (puerto 6543). En un
# proceso persistente, la API cambia ese pooler a modo sesión (puerto 5432).
# Para volver temporalmente al modo transacción sin alterar la URL original:
# EXPRESS_DATABASE_POOL_MODE=transaction
# NEST_DATABASE_POOL_MODE=transaction
# Máximo de conexiones por proceso al usar modo sesión (1-20; defecto: 5):
# EXPRESS_DATABASE_CONNECTION_LIMIT=5
# NEST_DATABASE_CONNECTION_LIMIT=5
# Registra únicamente método, ruta plantilla, estado y duración de solicitudes
# lentas de Express. No registra URL completa, parámetros ni cuerpos:
# API_SLOW_REQUEST_MS=500
# Swagger Express está disponible en desarrollo. Para habilitarlo expresamente
# en producción (revisar antes la exposición pública del inventario de rutas):
# API_DOCS_ENABLED=true
SUPABASE_DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# ── JWT ─────────────────────────────────────────────────────────────────────
# Genera un secreto aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# URL pública del sitio desplegado, por ejemplo: https://europlate-web.onrender.com
WEB_ORIGIN=https://europlate-web.onrender.com
